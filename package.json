{
  "name": "warden-ext",
  "displayName": "Warden",
  "description": "Guided VS Code workflows for Warden user lifecycle operations on Salesforce orgs",
  "version": "0.3.1",
  "publisher": "syntax-syllogism",
  "author": "Jake Richter <j.p.richter@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntax-Syllogism/warden-code-ext.git"
  },
  "bugs": {
    "url": "https://github.com/Syntax-Syllogism/warden-code-ext/issues"
  },
  "homepage": "https://github.com/Syntax-Syllogism/warden-code-ext#readme",
  "icon": "media/warden-logo.png",
  "keywords": [
    "salesforce",
    "sf",
    "sfdx",
    "warden",
    "user lifecycle"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "workspaceContains:**/.sf/config.json",
    "onView:wardenCommands"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "warden.provision",
        "title": "SF Warden: Provision"
      },
      {
        "command": "warden.access",
        "title": "SF Warden: Access"
      },
      {
        "command": "warden.diff",
        "title": "SF Warden: Diff"
      },
      {
        "command": "warden.freeze",
        "title": "SF Warden: Freeze"
      },
      {
        "command": "warden.unfreeze",
        "title": "SF Warden: Unfreeze"
      },
      {
        "command": "warden.strip",
        "title": "SF Warden: Strip"
      },
      {
        "command": "warden.snapshot",
        "title": "SF Warden: Snapshot"
      },
      {
        "command": "warden.restore",
        "title": "SF Warden: Restore"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*persona*.json",
          "**/personas/*.json"
        ],
        "url": "./schemas/persona-definitions.schema.json"
      },
      {
        "fileMatch": [
          "*user*-def.json",
          "*users*.json"
        ],
        "url": "./schemas/users-definition.schema.json"
      },
      {
        "fileMatch": [
          "*related*.json"
        ],
        "url": "./schemas/related-catalog.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden",
          "title": "Warden",
          "icon": "media/warden.svg"
        }
      ]
    },
    "views": {
      "warden": [
        {
          "id": "wardenCommands",
          "name": "Commands"
        }
      ]
    },
    "configuration": {
      "title": "Warden",
      "properties": {
        "warden.defaultTargetOrg": {
          "type": "string",
          "default": "",
          "description": "Default Salesforce org alias or username for Warden commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run copy:schemas && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run copy:schemas && npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "test": "vscode-test",
    "sync:contributes": "node scripts/sync-contributes.mjs",
    "copy:schemas": "node scripts/copy-schemas.mjs"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@salesforce/core": "^8",
    "@syntax-syllogism/warden-core": "0.4.1",
    "zod": "^4"
  }
}
