{
  "config": {
    "default": true,
    // Keep prose, tables, and URLs readable without hard-wrapping at 80 chars.
    "MD013": false,
    // Allow repeated headings in changelog-style sections.
    "MD024": false,
    // Allow intentional inline HTML in community and generated docs.
    "MD033": false,
    // Allow language-less fences in docs that show generic output.
    "MD040": false,
    // Allow GitHub templates and pointer files without a top-level heading.
    "MD041": false,
    // Allow existing images/badges whose alt text is handled externally.
    "MD045": false,
    // Allow compact Markdown tables without blocking commits on manual spacing.
    "MD060": false
  },
  "ignores": [
    ".history/**",
    ".vscode-test/**",
    "dist/**",
    "node_modules/**",
    "out/**"
  ]
}
